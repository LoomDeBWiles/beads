   111				issue.ClosedAt, issue.ExternalRef, sourceRepo, issue.CloseReason,
   112				issue.DeletedAt, issue.DeletedBy, issue.DeleteReason, issue.OriginalType,
   113				issue.Sender, wisp, pinned, isTemplate, issue.ClaimExpiresAt,
   114			)
