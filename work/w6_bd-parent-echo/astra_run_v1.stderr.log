   395					DependsOnID: waitsFor,
   396					Type:        types.DepWaitsFor,
   397					Metadata:    string(metaJSON),
   398				}
   399				if err := store.AddDependency(ctx, dep, actor); err != nil {
   400					WarnError("failed to add waits-for dependency %s -> %s: %v", issue.ID, waitsFor, err)
   401				}
