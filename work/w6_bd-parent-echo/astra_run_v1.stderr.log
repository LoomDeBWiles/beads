    31	// recordCreatedEvents bulk records creation events for multiple issues
    32	func recordCreatedEvents(ctx context.Context, conn *sql.Conn, issues []*types.Issue, actor string) error {
    33		stmt, err := conn.PrepareContext(ctx, `
