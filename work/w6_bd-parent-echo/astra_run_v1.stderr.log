    23	// insertIssue inserts a single issue into the database
    24	func insertIssue(ctx context.Context, conn *sql.Conn, issue *types.Issue) error {
    25		sourceRepo := issue.SourceRepo
    26		if sourceRepo == "" {
    27			sourceRepo = "." // Default to primary repo
    28		}
    29	
    30		wisp := 0
    31		if issue.Wisp {
    32			wisp = 1
    33		}
    34		pinned := 0
    35		if issue.Pinned {
    36			pinned = 1
    37		}
    38		isTemplate := 0
    39		if issue.IsTemplate {
    40			isTemplate = 1
    41		}
    42	
    43		_, err := conn.ExecContext(ctx, `
    44			INSERT OR IGNORE INTO issues (
    45				id, content_hash, title, description, design, acceptance_criteria, notes,
    46				status, priority, issue_type, assignee, estimated_minutes,
    47				created_at, updated_at, closed_at, external_ref, source_repo, close_reason,
    48				deleted_at, deleted_by, delete_reason, original_type,
    49				sender, ephemeral, pinned, is_template, claim_expires_at
    50			) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    51		`,
    52			issue.ID, issue.ContentHash, issue.Title, issue.Description, issue.Design,
    53			issue.AcceptanceCriteria, issue.Notes, issue.Status,
    54			issue.Priority, issue.IssueType, issue.Assignee,
    55			issue.EstimatedMinutes, issue.CreatedAt, issue.UpdatedAt,
    56			issue.ClosedAt, issue.ExternalRef, sourceRepo, issue.CloseReason,
    57			issue.DeletedAt, issue.DeletedBy, issue.DeleteReason, issue.OriginalType,
    58			issue.Sender, wisp, pinned, isTemplate, issue.ClaimExpiresAt,
    59		)
    60		if err != nil {
    61			// INSERT OR IGNORE should handle duplicates, but driver may still return error
    62			// Explicitly ignore UNIQUE constraint errors (expected for duplicate IDs in JSONL)
    63			if !isUniqueConstraintError(err) {
    64				return fmt.Errorf("failed to insert issue: %w", err)
    65			}
    66			// Duplicate ID detected and ignored (INSERT OR IGNORE succeeded)
    67		}
    68		return nil
    69	}
