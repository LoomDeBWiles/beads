    10	// Uses INSERT...ON CONFLICT to ensure atomicity without explicit locking.
    11	func (s *SQLiteStorage) getNextChildNumber(ctx context.Context, parentID string) (int, error) {
    12		var nextChild int
    13		err := s.db.QueryRowContext(ctx, `
    14			INSERT INTO child_counters (parent_id, last_child)
    15			VALUES (?, 1)
    16			ON CONFLICT(parent_id) DO UPDATE SET
    17				last_child = last_child + 1
    18			RETURNING last_child
    19		`, parentID).Scan(&nextChild)
    20		if err != nil {
    21			return 0, fmt.Errorf("failed to generate next child number for parent %s: %w", parentID, err)
    22		}
    23		return nextChild, nil
    24	}
