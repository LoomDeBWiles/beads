    39		}
    40		defer func() { _ = stmt.Close() }()
    41	
    42		for _, issue := range issues {
    43			eventData, err := json.Marshal(issue)
    44			if err != nil {
    45				// Fall back to minimal description if marshaling fails
    46				eventData = []byte(fmt.Sprintf(`{"id":"%s","title":"%s"}`, issue.ID, issue.Title))
    47			}
    48	
    49			_, err = stmt.ExecContext(ctx, issue.ID, types.EventCreated, actor, string(eventData))
    50			if err != nil {
    51				return fmt.Errorf("failed to record event for %s: %w", issue.ID, err)
    52			}
    53		}
