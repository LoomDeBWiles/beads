		allSame := true
		for _, issue := range issues {
			if extractIssuePrefix(issue.ID) != firstPrefix {
				allSame = false
				break
			}
		}

		if allSame && firstPrefix != "" {
			return firstPrefix, nil
		}

		// If issues have mixed prefixes, we can't auto-detect
		if !allSame {
